FROM php:8.4-fpm-alpine
RUN apk add --no-cache libpq \
    && apk add --no-cache --virtual .build-deps libpq-dev linux-headers $PHPIZE_DEPS \
    && docker-php-ext-install opcache pdo_pgsql \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps \
    && mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/backend/php.production.ini /usr/local/etc/php/conf.d/zz-signalrate.ini
COPY docker/backend/www.production.conf /usr/local/etc/php-fpm.d/zz-signalrate.conf
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /var/www
COPY backend/composer.* ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --no-scripts
COPY backend/ ./
COPY docker/backend/entrypoint.production.sh /usr/local/bin/signalrate-entrypoint
RUN composer dump-autoload --no-dev --classmap-authoritative \
    && chmod 755 /usr/local/bin/signalrate-entrypoint \
    && chown -R www-data:www-data storage bootstrap/cache
USER www-data
ENTRYPOINT ["/usr/local/bin/signalrate-entrypoint"]
