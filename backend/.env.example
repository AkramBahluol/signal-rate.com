APP_NAME=SignalRate
APP_ENV=local # production: production
APP_KEY=
APP_DEBUG=true # production: false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://signal-rate.com
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
DIRECTORY_RATE_LIMIT_PER_MINUTE=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=signalrate
DB_USERNAME=signalrate
DB_PASSWORD=change-me-local-only

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Comma-separated IP/CIDR values for proxies controlled by this deployment only.
# Configure the exact Nginx/load-balancer addresses or maintained Cloudflare ranges in production.
NETWORK_TRUSTED_PROXIES=
NETWORK_PROVIDER_TIMEOUT=5
NETWORK_SOCKET_TIMEOUT=3
NETWORK_MAX_RESPONSE_BYTES=1048576
NETWORK_LOOKUP_CACHE_SECONDS=900

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
