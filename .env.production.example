APP_NAME=SignalRate
SIGNALRATE_RELEASE=latest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://signal-rate.com
FRONTEND_URL=https://signal-rate.com
SITE_URL=https://signal-rate.com
NEXT_PUBLIC_SITE_URL=https://signal-rate.com
# Empty means same-origin /api through production Nginx.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ADS_TXT_LINE=
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=signalrate
DB_USERNAME=signalrate
DB_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
# Exact edge-network gateway passed by private Nginx through FastCGI. Do not use *.
NETWORK_TRUSTED_PROXIES=172.30.0.1
DIRECTORY_RATE_LIMIT_PER_MINUTE=60
INTERNAL_DIRECTORY_RATE_LIMIT_PER_MINUTE=3000
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
