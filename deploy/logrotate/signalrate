/var/log/nginx/signalrate-access.log {
    daily
    rotate 14
    maxsize 25M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        systemctl reload nginx >/dev/null 2>&1 || true
    endscript
}

/var/log/nginx/signalrate-access.json.log {
    daily
    rotate 14
    maxsize 50M
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        systemctl reload nginx >/dev/null 2>&1 || true
    endscript
}

/var/log/nginx/signalrate-security.json.log {
    daily
    rotate 3
    maxsize 25M
    missingok
    notifempty
    compress
    delaycompress
    create 0600 root root
    sharedscripts
    postrotate
        systemctl reload nginx >/dev/null 2>&1 || true
    endscript
}

/var/log/signalrate/deployments.json.log {
    weekly
    rotate 26
    missingok
    notifempty
    compress
    delaycompress
    create 0640 signalrate adm
}
