# Copy to /etc/signalrate/operations.env, keep mode 0600, and never commit real values.
SIGNALRATE_PUBLIC_ORIGIN=https://signal-rate.com
SIGNALRATE_ENV_FILE=.env.production
SIGNALRATE_BACKUP_DIR=/opt/signalrate/backups
SIGNALRATE_BACKUP_RETENTION_DAYS=7
SIGNALRATE_DISK_WARNING_PERCENT=80
SIGNALRATE_MEMORY_WARNING_PERCENT=15
SIGNALRATE_CERTIFICATE_WARNING_DAYS=21
SIGNALRATE_5XX_WARNING_COUNT=1
SIGNALRATE_RESTIC_READ_SUBSET=5%

# Required before enabling the off-server backup timers.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/signalrate/restic-password

# Provider credentials belong here when the selected restic backend requires them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional HTTPS webhook for external alerts. Keep the URL secret.
SIGNALRATE_ALERT_WEBHOOK_URL=
