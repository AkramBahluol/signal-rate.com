[Unit]
Description=Restore and verify the latest encrypted SignalRate backup
After=docker.service network-online.target
Wants=network-online.target
OnFailure=signalrate-alert@backup-verify.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/signalrate
ExecStart=/opt/signalrate/scripts/verify-offsite-backup.sh
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
